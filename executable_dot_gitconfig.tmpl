[user]
	name = Alessio Sarica
	email = 39183476-AleCode.jar@users.noreply.gitlab.com
	signingkey = {{ onepasswordRead "op://Personal/azgmql4ffz444j4ke63prvjfwu/public key" }}
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true

[includeIf "gitdir:~/Developer/UNIDEA/"]
	path = ~/.gitconfig.unidea
[gpg "ssh"]
{{- if eq .chezmoi.os "linux" }}
	program = "/opt/1Password/op-ssh-sign"
{{- else }}
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
{{- end }}

[init]
	defaultBranch = main
[credential]
	helper = cache --timeout=3600
[alias]
	st = status
	co = checkout
	br = branch
	cm = commit -m
	lg = log --oneline --graph --decorate --all
[core]
	autocrlf = input
