[user]
	name = Alessio Sarica
	email = 313584398+alessiosarica@users.noreply.github.com
	signingkey = ~/.ssh/id_ed25519_sk_rk_yk_daily.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true

[includeIf "gitdir:~/Developer/UNIDEA/"]
	path = ~/.gitconfig.unidea

[init]
	defaultBranch = main
[credential]
	helper = cache --timeout=3600
[alias]
	st = status
	co = checkout
	br = branch
	cm = commit -m
	lg = log --oneline --graph --decorate --all
[core]
	autocrlf = input
{{- if eq .chezmoi.os "darwin" }}
[gpg "ssh"]
	program = /Users/a.sarica/.ssh/ssh_signer_wrapper.sh
{{- end }}
